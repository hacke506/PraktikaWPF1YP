<Page x:Class="PraktikaWPF1YP.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PraktikaWPF1YP"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPage">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="8" Padding="30" Width="360" 
                BorderBrush="#CCCCCC" BorderThickness="1" SnapsToDevicePixels="True">
            <StackPanel>
                <TextBlock Text="Регистрация" FontSize="22" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#333333"/>

                <!-- Поле Логин -->
                <TextBlock Text="Придумайте логин:" Margin="0,5,0,2"/>
                <TextBox x:Name="TxtLogin" Height="35" VerticalContentAlignment="Center" Padding="5,0"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль:" Margin="0,10,0,2"/>
                <PasswordBox x:Name="TxtPassword" Height="35" VerticalContentAlignment="Center" Padding="5,0"/>

                <!-- Повтор пароля -->
                <TextBlock Text="Повторите пароль:" Margin="0,10,0,2"/>
                <PasswordBox x:Name="TxtConfirmPassword" Height="35" VerticalContentAlignment="Center" Padding="5,0"/>

                <!-- Выбор Роли -->
                <TextBlock Text="Роль пользователя:" Margin="0,10,0,2"/>
                <ComboBox x:Name="ComboRole" Height="35" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Пользователь" IsSelected="True"/>
                    <ComboBoxItem Content="Администратор"/>
                </ComboBox>

                <!-- Кнопки -->
                <Button x:Name="BtnRegister" Content="Зарегистрироваться" Height="40" Margin="0,25,0,0" 
                        Background="#28A745" Foreground="White" FontWeight="Bold" Click="BtnRegister_Click"/>

                <Button Content="Уже есть аккаунт? Войти" 
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                        Margin="0,15,0,0" Foreground="#007ACC" Click="BtnGoToAuth_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
