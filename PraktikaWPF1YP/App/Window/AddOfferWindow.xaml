<Window x:Class="PraktikaWPF1YP.AddOfferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PraktikaWPF1YP"
        mc:Ignorable="d"
        Title="AddOfferWindow" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,5">
            <TextBlock Text="Дата назначения этапа:" Margin="0,0,0,3" FontWeight="SemiBold"/>
            <DatePicker x:Name="DpDate" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="Текущий статус отбора (Тип этапа):" Margin="0,0,0,3" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtStatus" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,5">
            <TextBlock Text="Предлагаемый оклад (руб):" Margin="0,0,0,3" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtSumma" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,15,0,0">
            <Button Content="Назначить" Click="BtnSave_Click" Width="100" Height="32" Background="#2ECC71" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
            <Button Content="Отмена" Click="BtnCancel_Click" Width="100" Height="32" Background="#95A5A6" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
