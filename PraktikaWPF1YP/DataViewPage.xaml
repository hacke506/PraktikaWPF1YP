<Page x:Class="PraktikaWPF1YP.DataViewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PraktikaWPF1YP"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DataViewPage">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <WrapPanel Grid.Row="0" Margin="10,5">
            
        </WrapPanel>

        
        <DataGrid x:Name="DataGridContracts" AutoGenerateColumns="False" Margin="10" Grid.Row="1" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер полиса" Binding="{Binding nomer_polisa}" Width="*"/>
                <DataGridTextColumn Header="Дата начала" Binding="{Binding data_nachala, StringFormat=\{0:dd.MM.yyyy\}}" Width="*"/>
                <DataGridTextColumn Header="Дата окончания" Binding="{Binding data_okonchaniya, StringFormat=\{0:dd.MM.yyyy\}}" Width="*"/>
                <DataGridTextColumn Header="Страховая сумма" Binding="{Binding strahovaya_summa}" Width="*"/>
                <DataGridTextColumn Header="Премия" Binding="{Binding premiya}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
            <Button Content="➕ Добавить" Background="#2ECC71" Foreground="White" Padding="12,7" Margin="5" FontWeight="Bold"/>
            <Button Content="❌ Удалить каскадно" Background="#E74C3C" Foreground="White" Padding="12,7" Margin="5" FontWeight="Bold"/>

            
            <Button Content="📊 Экспорт в Excel" Click="BtnExportExcel_Click" Background="#217346" Foreground="White" Padding="12,7" Margin="5" FontWeight="Bold"/>
            <Button Content="📝 Экспорт в Word" Click="BtnExportWord_Click" Background="#2B579A" Foreground="White" Padding="12,7" Margin="5" FontWeight="Bold"/>
            <Button Content="📕 Экспорт в PDF" Click="BtnExportPdf_Click" Background="#E01A22" Foreground="White" Padding="12,7" Margin="5" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Page>
