<Page x:Class="PraktikaWPF1YP.ChangePasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PraktikaWPF1YP"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChangePasswordPage">

    <Grid Margin="30">
        <StackPanel Width="250" HorizontalAlignment="Left">
            <TextBlock Text="Смена текущего пароля" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Введите старый пароль:" Margin="0,5,0,2"/>
            <PasswordBox x:Name="TxtOldPass" Height="30"/>

            <TextBlock Text="Введите новый пароль:" Margin="0,10,0,2"/>
            <PasswordBox x:Name="TxtNewPass" Height="30"/>

            <Button Content="Сохранить изменения" Click="BtnSavePassword_Click" Height="38" Margin="0,20,0,0" Background="#E67E22" Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>
